{
  "Hotkey": {
    "Control": true,
    "Shift": false,
    "Alt": true,
    "Win": false,
    "Key": "K"
  },
  "Ai": {
    "Provider": "GigaChat",
    "BaseUrl": "https://api.giga.chat/v1",
    "AuthUrl": "https://ngw.devices.sberbank.ru:9443/api/v2/oauth",
    "ApiKey": "",
    "AuthorizationKey": "",
    "ClientId": "",
    "Scope": "GIGACHAT_API_PERS",
    "Model": "GigaChat-2",
    "Temperature": 0.2,
    "MaxTokens": 1024,
    "TimeoutSeconds": 30,
    "IgnoreSslErrors": true,
    "ShortTextMaxLength": 200,
    "LongTextMinLength": 800,
    "DefaultPromptMode": "Auto"
  },
  "Clipboard": {
    "CopyRetryCount": 12,
    "CopyPollIntervalMs": 100,
    "CopySettleDelayMs": 80,
    "ForceCopyDelayMs": 200,
    "ForegroundPrepareDelayMs": 120,
    "KeyDelayMs": 30,
    "RecentClipboardMaxAgeSeconds": 15,
    "CorrectedTextCooldownSeconds": 60,
    "RestoreClipboardAfterPaste": true
  },
  "Ui": {
    "ShowTrayIcon": true,
    "ShowNotesInDialog": true,
    "ShowCorrectionPreview": true,
    "AutoStartOnWindowsStartup": false,
    "PreviewAutoCloseSeconds": 5,
    "ToastAutoCloseSeconds": 3
  }
}
