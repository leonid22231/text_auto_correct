<Window x:Class="TextAutoCorrect.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text Auto Correct — Settings"
        Height="760"
        Width="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="AI Provider" FontWeight="Bold" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Provider" VerticalAlignment="Center"/>
            <ComboBox x:Name="ProviderBox" Grid.Row="1" Grid.Column="1" Margin="0,4">
                <ComboBoxItem Content="GigaChat"/>
                <ComboBoxItem Content="OpenAI"/>
            </ComboBox>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Authorization key" VerticalAlignment="Center"/>
            <PasswordBox x:Name="AuthorizationKeyBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="OpenAI API key" VerticalAlignment="Center"/>
            <PasswordBox x:Name="ApiKeyBox" Grid.Row="3" Grid.Column="1" Margin="0,4"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Client ID" VerticalAlignment="Center"/>
            <TextBox x:Name="ClientIdBox" Grid.Row="4" Grid.Column="1" Margin="0,4"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Scope" VerticalAlignment="Center"/>
            <TextBox x:Name="ScopeBox" Grid.Row="5" Grid.Column="1" Margin="0,4"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Auth URL" VerticalAlignment="Center"/>
            <TextBox x:Name="AuthUrlBox" Grid.Row="6" Grid.Column="1" Margin="0,4"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Base URL" VerticalAlignment="Center"/>
            <TextBox x:Name="BaseUrlBox" Grid.Row="7" Grid.Column="1" Margin="0,4"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Model" VerticalAlignment="Center"/>
            <TextBox x:Name="ModelBox" Grid.Row="8" Grid.Column="1" Margin="0,4"/>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Temperature" VerticalAlignment="Center"/>
            <TextBox x:Name="TemperatureBox" Grid.Row="9" Grid.Column="1" Margin="0,4"/>

            <TextBlock Grid.Row="10" Grid.Column="0" Text="Max tokens" VerticalAlignment="Center"/>
            <TextBox x:Name="MaxTokensBox" Grid.Row="10" Grid.Column="1" Margin="0,4"/>

            <TextBlock Grid.Row="11" Grid.Column="0" Text="Timeout (sec)" VerticalAlignment="Center"/>
            <TextBox x:Name="TimeoutBox" Grid.Row="11" Grid.Column="1" Margin="0,4"/>

            <TextBlock Grid.Row="12" Grid.Column="0" Text="Prompt mode" VerticalAlignment="Center"/>
            <ComboBox x:Name="PromptModeBox" Grid.Row="12" Grid.Column="1" Margin="0,4"/>

            <StackPanel Grid.Row="13" Grid.Column="1" Margin="0,8">
                <CheckBox x:Name="IgnoreSslBox"
                          Content="Ignore SSL errors (GigaChat / Минцифры cert)"/>
                <CheckBox x:Name="AutoStartBox"
                          Content="Autostart on Windows login"
                          Margin="0,6,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="14" Grid.ColumnSpan="2" Text="Hotkey" FontWeight="Bold" Margin="0,16,0,8"/>

            <TextBlock Grid.Row="15" Grid.Column="0" Text="Key" VerticalAlignment="Center"/>
            <TextBox x:Name="HotkeyKeyBox" Grid.Row="15" Grid.Column="1" Margin="0,4"/>

            <StackPanel Grid.Row="16" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                <CheckBox x:Name="HotkeyCtrlBox" Content="Ctrl" Margin="0,0,12,0"/>
                <CheckBox x:Name="HotkeyShiftBox" Content="Shift" Margin="0,0,12,0"/>
                <CheckBox x:Name="HotkeyAltBox" Content="Alt" Margin="0,0,12,0"/>
                <CheckBox x:Name="HotkeyWinBox" Content="Win"/>
            </StackPanel>

            <StackPanel Grid.Row="17" Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="Cancel" Width="100" Margin="0,0,8,0" Click="CancelButton_OnClick"/>
                <Button Content="Save" Width="100" Click="SaveButton_OnClick"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
